PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Configuration
# Found under: Supabase Project Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron Webhook Authentication Secret (used by cron-job.org)
CRON_SECRET=your-random-secure-cron-secret

# Target Mock Store URL
MOCK_STORE_URL=https://demo.inelabteamdev.com
